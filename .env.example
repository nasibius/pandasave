# EMAIL_USER: SMTP email user (e.g. your_email@gmail.com)
# EMAIL_PASS: SMTP email password (e.g. app password)
EMAIL_USER=
EMAIL_PASS=

# APP_URL: The base URL of your deployed frontend (e.g. https://your-domain.vercel.app or http://localhost:3000)
# Used by the backend to construct password reset and email verification links.
APP_URL=http://localhost:3000

# VITE_API_URL: The base URL of your deployed backend (e.g. https://my-backend.railway.app)
# Required if you deploy the frontend and backend separately (like frontend on Vercel, backend on Railway).
# If running them together, leave this blank.
VITE_API_URL=
