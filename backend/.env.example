# APP_URL: The base URL of your deployed frontend (e.g. https://your-domain.vercel.app or http://localhost:3000)
# Used by the backend to construct password reset and email verification links.
APP_URL=http://localhost:3000

# EMAIL_USER: SMTP email user (e.g. your_email@gmail.com)
# EMAIL_PASS: SMTP email password (e.g. app password)
EMAIL_USER=
EMAIL_PASS=

# JWT_SECRET: Secret phrase to securely sign JWT tokens
JWT_SECRET=super-secret-pandasave-key
